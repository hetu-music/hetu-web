{
  "name": "hetu-web",
  "version": "1.8.12",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:sw",
    "build:next": "next build",
    "build:sw": "pnpm exec tsx scripts/build-sw.ts",
    "build:icons": "pnpm exec tsx scripts/generate-icons.ts",
    "build:pwa": "pnpm build:icons && pnpm build:next && pnpm build:sw",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,css,scss}\" \"scripts/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,jsx,tsx,json,css,scss}\" \"scripts/**/*.{js,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quiz:diagnose": "tsx --env-file=.env.local scripts/quiz-diagnose.ts",
    "quiz:check": "tsx --env-file=.env.local scripts/quiz-check.ts",
    "imagery:llm-check": "tsx --env-file=.env.local scripts/imagery-llm-check.ts",
    "navidrome:sync": "tsx --env-file=.env.local scripts/navidrome-sync.ts",
    "qjtx:assets": "tsx scripts/qjtx-assets.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "5.9.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.6",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "opencc-js": "^1.4.2",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@huggingface/transformers": "^4.3.0",
    "@serwist/build": "^9.5.12",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@tweakpane/core": "^2.0.5",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "serwist": "^9.5.12",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tweakpane": "^4.0.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
