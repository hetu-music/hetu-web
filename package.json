{
  "name": "hetu-web",
  "version": "1.8.15",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:sw",
    "build:next": "next build",
    "build:sw": "pnpm exec tsx scripts/build-sw.ts",
    "build:icons": "pnpm exec tsx scripts/generate-icons.ts",
    "build:pwa": "pnpm build:icons && pnpm build:next && pnpm build:sw",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,css,scss}\" \"scripts/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,jsx,tsx,json,css,scss}\" \"scripts/**/*.{js,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quiz:diagnose": "tsx --env-file=.env.local scripts/quiz-diagnose.ts",
    "quiz:check": "tsx --env-file=.env.local scripts/quiz-check.ts",
    "imagery:llm-check": "tsx --env-file=.env.local scripts/imagery-llm-check.ts",
    "navidrome:sync": "tsx --env-file=.env.local scripts/navidrome-sync.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "5.9.1",
    "@marsidev/react-turnstile": "^1.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "framer-motion": "^14.0.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "opencc-js": "^1.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@serwist/build": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}