{
  "name": "hetu-web",
  "version": "1.8.22",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && pnpm build:sw",
    "build:next": "next build",
    "build:sw": "pnpm exec tsx scripts/build-sw.ts",
    "build:icons": "pnpm exec tsx scripts/generate-icons.ts",
    "build:pwa": "pnpm build:icons && pnpm build:next && pnpm build:sw",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{js,ts,jsx,tsx,json,css,scss}\" \"scripts/**/*.{js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,jsx,tsx,json,css,scss}\" \"scripts/**/*.{js,ts}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "quiz:diagnose": "tsx --env-file=.env.local scripts/quiz-diagnose.ts",
    "quiz:check": "tsx --env-file=.env.local scripts/quiz-check.ts",
    "imagery:llm-check": "tsx --env-file=.env.local scripts/imagery-llm-check.ts",
    "imagery:check": "tsx --env-file=.env.local scripts/imagery-check.ts",
    "emotion:eval": "tsx --env-file=.env.local scripts/emotion-eval.ts",
    "emotion:label": "tsx --env-file=.env.local scripts/emotion-label.ts",
    "navidrome:sync": "tsx --env-file=.env.local scripts/navidrome-sync.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "6.0.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "clsx": "^2.1.1",
    "framer-motion": "^14.6.0",
    "fuse.js": "^7.5.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "opencc-js": "^1.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@serwist/build": "^9.5.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "serwist": "^9.5.13",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}